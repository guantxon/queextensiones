      "id": "redis_get",
      "name": "Cargar estado",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        -1120,
        420
      ],
      "credentials": {
        "redis": {
          "id": "uUALR6mzUYb59fEr",
